import os 
import sys,string
import numpy as np
import argparse
from astropy.table import Table 
import matplotlib.pyplot as plt

def get_argpars(): 
    parser = argparse.ArgumentParser(formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    parser.add_argument('-c', '--ic', type=str, required=True, 
                        help='input catalog', action = 'store')
    parser.add_argument('--radec_cols', type=int, nargs=2, required=False, default=[1,2],
                        help='ra & dec cols of input catalog')    
    parser.add_argument('-m', '--im', type=str,  required = True, 
                        help='input masking file', action = 'store') 
    parser.add_argument('-o', '--outputfile', type=str,  default = "mask_results.fits", 
                        help='output file', action = 'store')  
    return parser.parse_args() 


import csstmock.asfunc as asfunc
import csstmock.utils  as utils
if __name__ == '__main__': 
    args = get_argpars()
    tc   = utils.file2table(args.ic, usecols=args.radec_cols, colnames = ['ra', 'dec']) 
    tc   = utils.auto_firstidcol(tc)
    tm   = utils.file2table(args.im)
    tm   = asfunc.fixtabfmt_mask(tm)
    firstcol = tc[ tc.colnames[0], ]
    counting = asfunc.ellipse_counting(tc['ra'], tc['dec'], 
                           tm['ra'], tm['dec'], tm['sma'], 
                           tm['pa'], tm['ba'],  tm['w']) 
    counting[counting > 0] = 1
    firstcol['ismasked'] = counting # counting
    print('saving into %s'%args.outputfile) 
    firstcol.write(args.outputfile, overwrite = True) 
